import numpy as np

def step(x): return 1 if x>0 else @

X = np.array([[2,3], [3,2], [1,1], [5,7], [6,8], [7,6]])

y= np.array([0,0,0,1,1,1])

w = np.zeros(2); b = 0

for in range(100): for xi, yi in zip(X, y): e = yi step(np.dot(w, xi) + b) w += 0.1 e xi; b += 0.1 e

for d in [[4,5], [2,2]]: print(f"Data (d) belongs to class (step(np.dot(w,d)+b)}")
