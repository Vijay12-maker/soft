import numpy as np

sig = lambda x: 1/(1+np.exp(-x))

dsig = lambda x: x*(1-x)

X = np.array([[0,0], [0,1], [1,0], [1,1]])

y = np.array([[0], [1], [1], [0]])

w1 = np.random.rand(2,2)

w2 = np.random.rand(2,1)

for in range (10000): h = sig(X@ w1) o = sig(h@ w2)

e=yo

d2 = e dsig(o)

d1 = (d2 @ w2.T) dsig(h)

w2 += h.T @ d2 0.1 w1 += X.T @ d1 0.1

for d in X:

h = sig(d @ w1)

o = sig(h @ w2)

print(f"Input: {d) Predicted Output: (o[0]}")
